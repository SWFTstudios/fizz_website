<footer class="w-full py-12 md:py-20 bg-surface-container-lowest border-t border-outline-variant">
  <div class="grid grid-cols-1 md:grid-cols-4 gap-gutter px-margin-mobile md:px-margin-desktop max-w-max-width mx-auto">
    <div>
      <div class="font-headline-lg text-on-background mb-6">{{ shop.name | default: 'FIZZ' }}</div>
      <p class="text-on-surface-variant font-body-md">{{ section.settings.tagline }}</p>
    </div>
    <div>
      <h4 class="font-label-caps text-primary mb-6 uppercase">Explore</h4>
      <div class="flex flex-col gap-3">
        {% for link in linklists[section.settings.explore_menu].links %}
          <a class="text-on-surface-variant hover:text-on-surface underline transition-all font-body-md" href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      </div>
    </div>
    <div>
      <h4 class="font-label-caps text-primary mb-6 uppercase">Support</h4>
      <div class="flex flex-col gap-3">
        {% for link in linklists[section.settings.support_menu].links %}
          <a class="text-on-surface-variant hover:text-on-surface underline transition-all font-body-md" href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      </div>
    </div>
    <div>
      <h4 class="font-label-caps text-primary mb-6 uppercase">Legal</h4>
      <div class="flex flex-col gap-3">
        <a class="text-on-surface-variant hover:text-on-surface underline transition-all font-body-md" href="{{ shop.privacy_policy.url }}">Privacy Policy</a>
        <a class="text-on-surface-variant hover:text-on-surface underline transition-all font-body-md" href="{{ shop.terms_of_service.url }}">Terms of Service</a>
      </div>
    </div>
  </div>
  <div class="mt-20 px-margin-mobile md:px-margin-desktop max-w-max-width mx-auto text-center md:text-left">
    <p class="text-on-surface-variant font-label-caps text-[10px]">© {{ 'now' | date: '%Y' }} {{ shop.name | upcase }}. ALL RIGHTS RESERVED.</p>
  </div>
</footer>

{% schema %}
{
  "name": "Kinetic Spark footer",
  "settings": [
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Redefining high-performance hydration for the modern era."
    },
    {
      "type": "link_list",
      "id": "explore_menu",
      "label": "Explore menu",
      "default": "footer"
    },
    {
      "type": "link_list",
      "id": "support_menu",
      "label": "Support menu",
      "default": "footer"
    }
  ]
}
{% endschema %}
