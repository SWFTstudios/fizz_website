{% render 'ks-nav',
  menu: section.settings.menu,
  show_cta: section.settings.show_cta,
  cta_label: section.settings.cta_label,
  cta_url: section.settings.cta_url
%}

{% schema %}
{
  "name": "Kinetic Spark header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show shop CTA",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    }
  ]
}
{% endschema %}
