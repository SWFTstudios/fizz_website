# 3D product page (see Bible/04-ASSETS-AND-R2.md)
# Phase: ocean (endless water only) or full (ocean + bottle + product panel)
VITE_B3D_PHASE=ocean
# Local dev (file at ~/Downloads/fizz_bottle_3d_file_export.gltf):
VITE_BOTTLE_GLTF_URL=/local-dev/fizz_bottle_3d_file_export.gltf
# Production (after R2 upload):
# VITE_BOTTLE_GLTF_URL=https://your-cdn/models/fizz_bottle_3d_file_export.gltf
# Optional override path for dev middleware:
# FIZZ_BOTTLE_GLTF_DEV_PATH=/path/to/fizz_bottle_3d_file_export.gltf
# Local dev (file at ~/Downloads/ocean_scene_self_hosted/ocean.gltf):
VITE_OCEAN_GLTF_URL=/local-dev/ocean.gltf
# Optional override path for dev middleware:
# FIZZ_OCEAN_GLTF_DEV_PATH=/path/to/ocean.gltf
