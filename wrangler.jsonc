{
  // Primary Worker: static fizz-final site (https://fizz-final.elombe.workers.dev).
  // Production: npm run deploy | Branch/PR previews: npm run deploy:preview
  // See docs/CLOUDFLARE-BUILDS.md for Workers Builds dashboard settings.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fizz-final",
  "compatibility_date": "2026-05-26",
  "assets": {
    "directory": "./fizz-final"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
